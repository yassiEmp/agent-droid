{
  "name": "agent-droid",
  "version": "0.2.0",
  "description": "An agent-browser for Android: drive a real device or emulator over adb, or remotely over Wi-Fi/4G with no cable, with a snapshot \u2192 ref \u2192 act loop. Animation-proof UI snapshots, text or ref targeting, JSON output \u2014 built for AI agents and humans.",
  "type": "module",
  "bin": {
    "agent-droid": "cli/droid.mjs",
    "droid": "cli/droid.mjs"
  },
  "files": [
    "cli/droid.mjs",
    "cli/lib.mjs",
    "cli/remote.mjs",
    "cli/relay.mjs",
    "cli/ws.mjs",
    "cli/vendor/*.apk",
    "dumper/**/*",
    "!dumper/build",
    "!dumper/.gradle",
    "MAINTAINING.md",
    "REMOTE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "doctor": "node cli/droid.mjs doctor",
    "help": "node cli/droid.mjs --help",
    "test": "node --test test/*.test.mjs",
    "relay": "node cli/droid.mjs relay"
  },
  "keywords": [
    "android",
    "adb",
    "uiautomator",
    "automation",
    "agent",
    "ai-agent",
    "react-native",
    "e2e",
    "cli",
    "accessibility-tree",
    "remote",
    "accessibility-service",
    "tailscale"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassiEmp/agent-droid.git"
  },
  "dependencies": {}
}
